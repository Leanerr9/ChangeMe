<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Number check</title>
<style>
  :root { --bg:#f5f7f6; --ink:#16231f; --muted:#5d6b66; --line:#d5dcd9; --accent:#1f6f5c; --card:#fff; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#101716; --ink:#e8efec; --muted:#9aa9a3; --line:#2a3633; --accent:#5cc3a6; --card:#17211f; }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.5 system-ui, sans-serif; }
  main { max-width: 640px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 1.7rem; margin: 0 0 8px; }
  p { color: var(--muted); margin: 0 0 20px; }
  button { font: inherit; padding: 12px 18px; border-radius: 8px; border: 1px solid var(--accent);
           background: var(--accent); color: #fff; cursor: pointer; }
  button.ghost { background: transparent; color: var(--accent); }
  button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  #bar { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; margin: 16px 0; }
  #bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  li { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  li.done .name { text-decoration: line-through; color: var(--muted); }
  li input { width: 20px; height: 20px; accent-color: var(--accent); }
  .name { flex: 1; }
  .name small { display: block; color: var(--muted); }
  h2 { font-size: 1.05rem; margin: 28px 0 8px; }
  #status { color: var(--muted); }
  .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<main>
  <h1>Number check</h1>
  <p>Find the accounts that may use your phone number, so you can update them before you change it.
     Your email is read in this browser only. Nothing is sent to a server.</p>

  <section id="start">
    <p>You need a Google OAuth client ID. Paste it here, or set it in the code.</p>
    <input id="cid" placeholder="Google client ID" style="width:100%;padding:10px;margin-bottom:12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink)">
    <button id="signin">Sign in with Google</button>
  </section>

  <section id="scan" hidden>
    <div id="status">Starting...</div>
    <div id="bar"><i></i></div>
  </section>

  <section id="results" hidden>
    <div id="summary"></div>
    <div id="lists"></div>
    <div class="row">
      <button class="ghost" id="clear">Delete my saved ticks</button>
    </div>
  </section>
</main>

<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
// ---------- Settings ----------
const CLIENT_ID = ""; // Put your Google OAuth client ID here (or paste it in the box).
const SCOPE = "https://www.googleapis.com/auth/gmail.readonly";
const QUERY = '"verification code" OR "security code" OR "one-time" OR "2-step" OR "phone number" OR "sign-in code"';
const MAX_MESSAGES = 200;

// Known services: domain -> [display name, security settings link, priority (1 = most important)]
const KNOWN = {
  "google.com": ["Google", "https://myaccount.google.com/security", 1],
  "apple.com": ["Apple ID", "https://account.apple.com", 1],
  "microsoft.com": ["Microsoft", "https://account.microsoft.com/security", 1],
  "paypal.com": ["PayPal", "https://www.paypal.com/myaccount/settings", 1],
  "amazon.com": ["Amazon", "https://www.amazon.com/a/settings/approval", 2],
  "amazon.co.uk": ["Amazon UK", "https://www.amazon.co.uk/a/settings/approval", 2],
  "facebook.com": ["Facebook", "https://accountscenter.facebook.com/password_and_security", 2],
  "facebookmail.com": ["Facebook", "https://accountscenter.facebook.com/password_and_security", 2],
  "instagram.com": ["Instagram", "https://accountscenter.instagram.com/password_and_security", 2],
  "whatsapp.com": ["WhatsApp", "https://www.whatsapp.com", 2],
  "x.com": ["X", "https://x.com/settings/account", 3],
  "twitter.com": ["X", "https://x.com/settings/account", 3],
  "linkedin.com": ["LinkedIn", "https://www.linkedin.com/psettings/phone", 3],
  "revolut.com": ["Revolut", "https://app.revolut.com", 1],
  "wise.com": ["Wise", "https://wise.com/settings", 1],
  "coinbase.com": ["Coinbase", "https://www.coinbase.com/settings", 1],
  "binance.com": ["Binance", "https://www.binance.com/en/my/security", 1],
  "uber.com": ["Uber", "https://account.uber.com", 3],
  "ebay.com": ["eBay", "https://www.ebay.com/myb/Summary", 3],
  "discord.com": ["Discord", "https://discord.com/channels/@me", 3],
  "telegram.org": ["Telegram", "https://telegram.org", 2]
};
// Words in a domain that suggest money (shown near the top even if unknown).
const MONEY_HINTS = ["bank", "pay", "invest", "trade", "broker", "finance", "credit", "capital", "wallet", "crypto", "forex"];

// ---------- Helpers ----------
const $ = id => document.getElementById(id);
const STORE = "numbercheck.ticks";
const loadTicks = () => { try { return JSON.parse(localStorage.getItem(STORE)) || {}; } catch { return {}; } };
const saveTicks = t => { try { localStorage.setItem(STORE, JSON.stringify(t)); } catch {} };

// Reduce "mail.security.paypal.co.uk" to "paypal.co.uk".
function baseDomain(host) {
  const parts = host.toLowerCase().split(".");
  if (parts.length <= 2) return host.toLowerCase();
  const twoPartTlds = ["co.uk", "org.uk", "com.au", "co.nz", "co.in", "com.br"];
  const lastTwo = parts.slice(-2).join(".");
  return twoPartTlds.includes(lastTwo) ? parts.slice(-3).join(".") : lastTwo;
}

function parseFrom(header) {
  const m = header.match(/^\s*"?([^"<]*)"?\s*<([^>]+)>/) || [null, "", header.trim()];
  const email = m[2].trim();
  const host = email.split("@")[1];
  return host ? { name: m[1].trim(), domain: baseDomain(host) } : null;
}

async function gmail(path, token) {
  const r = await fetch("https://gmail.googleapis.com/gmail/v1/users/me/" + path,
    { headers: { Authorization: "Bearer " + token } });
  if (!r.ok) throw new Error("Gmail said " + r.status);
  return r.json();
}

function setProgress(text, pct) {
  $("status").textContent = text;
  document.querySelector("#bar i").style.width = pct + "%";
}

// ---------- Scan ----------
async function runScan(token) {
  $("start").hidden = true;
  $("scan").hidden = false;
  try {
    // 1. Find message IDs that look like code or security emails.
    let ids = [], pageToken = "";
    while (ids.length < MAX_MESSAGES) {
      const q = "messages?maxResults=100&q=" + encodeURIComponent(QUERY) + (pageToken ? "&pageToken=" + pageToken : "");
      const res = await gmail(q, token);
      ids = ids.concat((res.messages || []).map(m => m.id));
      setProgress("Found " + ids.length + " matching emails...", 10);
      if (!res.nextPageToken) break;
      pageToken = res.nextPageToken;
    }
    ids = ids.slice(0, MAX_MESSAGES);

    // 2. Read only the "From" line of each email (no message text).
    const found = {}; // domain -> { name, count }
    let done = 0;
    for (let i = 0; i < ids.length; i += 10) {
      const batch = ids.slice(i, i + 10);
      const msgs = await Promise.all(batch.map(id =>
        gmail("messages/" + id + "?format=metadata&metadataHeaders=From&fields=payload/headers", token).catch(() => null)));
      for (const m of msgs) {
        const h = m && m.payload && m.payload.headers && m.payload.headers[0];
        const who = h && parseFrom(h.value);
        if (!who) continue;
        found[who.domain] = found[who.domain] || { name: who.name, count: 0 };
        found[who.domain].count++;
      }
      done += batch.length;
      setProgress("Checked " + done + " of " + ids.length + " emails...", 10 + (done / ids.length) * 90);
    }
    showResults(found);
  } catch (e) {
    setProgress("Something went wrong: " + e.message + ". Reload and sign in again.", 0);
  } finally {
    token = null; // drop the token; we do not keep it
  }
}

// ---------- Results ----------
function showResults(found) {
  const items = Object.entries(found).map(([domain, v]) => {
    const k = KNOWN[domain];
    const money = MONEY_HINTS.some(w => domain.includes(w));
    return {
      domain,
      name: k ? k[0] : (v.name || domain),
      link: k ? k[1] : "https://" + domain,
      priority: k ? k[2] : (money ? 1 : 4),
      count: v.count
    };
  }).sort((a, b) => a.priority - b.priority || b.count - a.count);

  $("scan").hidden = true;
  $("results").hidden = false;
  const ticks = loadTicks();

  const groups = [
    [1, "Update first: email, money and big accounts"],
    [2, "Update next: social and shopping"],
    [3, "Then these"],
    [4, "Other services that sent codes"]
  ];
  const lists = $("lists");
  lists.innerHTML = "";
  for (const [p, title] of groups) {
    const part = items.filter(i => i.priority === p);
    if (!part.length) continue;
    const h = document.createElement("h2"); h.textContent = title;
    const ul = document.createElement("ul");
    for (const it of part) {
      const li = document.createElement("li");
      const cb = document.createElement("input"); cb.type = "checkbox"; cb.id = "c-" + it.domain;
      cb.checked = !!ticks[it.domain];
      li.classList.toggle("done", cb.checked);
      cb.addEventListener("change", () => {
        const t = loadTicks(); t[it.domain] = cb.checked; saveTicks(t);
        li.classList.toggle("done", cb.checked); updateSummary(items.length);
      });
      const label = document.createElement("label"); label.className = "name"; label.htmlFor = cb.id;
      label.textContent = it.name;
      const small = document.createElement("small"); small.textContent = it.domain + " (" + it.count + " emails)";
      label.appendChild(small);
      const a = document.createElement("a"); a.href = it.link; a.target = "_blank"; a.rel = "noopener noreferrer";
      a.textContent = "Open settings"; a.style.color = "var(--accent)";
      li.append(cb, label, a); ul.appendChild(li);
    }
    lists.append(h, ul);
  }
  if (!items.length) lists.textContent = "No code emails found. Check your other inboxes and your texts too.";
  updateSummary(items.length);
}

function updateSummary(total) {
  const t = loadTicks();
  const n = Object.values(t).filter(Boolean).length;
  $("summary").innerHTML = "";
  const p = document.createElement("p");
  p.textContent = total && n >= total
    ? "All done. It is safe to change your number. Keep the old one active for a few days."
    : n + " of " + total + " updated. This list only shows accounts that emailed you, so also check your texts and password manager.";
  $("summary").appendChild(p);
}

// ---------- Wire up ----------
$("signin").addEventListener("click", () => {
  const id = CLIENT_ID || $("cid").value.trim();
  if (!id) { alert("Add your Google client ID first."); return; }
  if (!window.google || !google.accounts) { alert("Google sign-in did not load. Check your connection."); return; }
  google.accounts.oauth2.initTokenClient({
    client_id: id,
    scope: SCOPE,
    callback: resp => { if (resp.access_token) runScan(resp.access_token); }
  }).requestAccessToken();
});

$("clear").addEventListener("click", () => {
  try { localStorage.removeItem(STORE); } catch {}
  location.reload();
});
</script>
</body>
</html>
